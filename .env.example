# =============================================================
# Ara Beddings — environment configuration (copy to .env, never commit .env)
# =============================================================

# --- Database (externally hosted PostgreSQL, e.g. Neon / Supabase / Railway) ---
# On Vercel set this in Project Settings -> Environment Variables.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require&connection_limit=10"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# --- App ---
APP_URL="http://localhost:3000"
APP_ENV="development"            # development | production
APP_KEY="replace-with-a-32+char-random-secret-used-to-sign-session-cookies"

# --- SMTP (any provider; used for order/account emails) ---
MAIL_HOST="smtp.example.com"
MAIL_PORT="587"
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_FROM="store@example.com"
